{
  "id": "io.github.frasersimpson126.nullbeat",
  "name": "NullBeat-Bridge",
  "version": "1.0.0",
  "versionCode": 1,
  "apiVersion": 1,
  "author": "You",
  "description": "Download/stream from TorBox caches resolved via Tidal metadata.",
  "category": "tools",
  "tags": ["tidal", "torbox", "flac"],
  "minAppVersion": "2.0.2",
  "actions": [
    { "name": "download.source", "why": "Provide cached TorBox files matched by Tidal metadata" },
    { "name": "audio.source", "why": "Stream the same TorBox cache without downloading" },
    {
      "name": "network",
      "why": "Tidal and TorBox APIs",
      "hosts": ["auth.tidal.com", "openapi.tidal.com", "api.torbox.app"]
    },
    { "name": "settings.page", "why": "Tidal & TorBox credentials and quality" },
    { "name": "storage", "why": "Cache the Tidal access token and filename hashes" },
    { "name": "status", "why": "Report whether the TorBox account answers" }
  ],
  "settings": [
    { "key": "tidal_client_id", "type": "text", "label": "Tidal Client ID", "section": "downloads" },
    { "key": "tidal_client_secret", "type": "secret", "label": "Tidal Client Secret", "section": "downloads" },
    { "key": "torbox_key", "type": "secret", "label": "TorBox API key", "section": "downloads" },
    {
      "key": "quality",
      "type": "choice",
      "label": "Preferred quality",
      "options": ["Hi-Res", "HiFi CD", "320kbps AAC", "96kbps"],
      "default": "HiFi CD",
      "section": "downloads",
      "role": "quality"
    },
    { "key": "atmos", "type": "toggle", "label": "Try Dolby Atmos", "default": true, "section": "downloads" }
  ]
}
